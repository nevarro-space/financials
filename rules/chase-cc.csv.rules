include global.rules

skip 1
fields card, date, posteddate, description, category, txntype, amount, memo

date-format %m/%d/%Y

currency $

account1 liabilities:credit-cards:chase:ink-unlimited
comment1 date:%posteddate
status *

if AUTOMATIC PAYMENT
    account2 equity:transfers

if Payment Thank You
    account2 equity:transfers

if Statement Credit Adjustme
    account2 revenue:credits-and-adjustments
